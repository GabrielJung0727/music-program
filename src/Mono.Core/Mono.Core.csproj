<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Mono.Core</RootNamespace>
    <AssemblyName>Mono.Core</AssemblyName>
    <!-- wwwroot 는 src/Mono.Web (React) 의 vite build 산출물이다.
         빌드 전에 한 번은 `npm run build` 가 돌아야 한다. -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- React 번들(src/Mono.Web 의 vite build 산출물)을 exe 옆으로 복사한다.
         StaticWebAssetsEnabled 가 꺼져 있어 ASP.NET 기본 규칙이 안 태워 주므로
         명시적으로 넣는다. 번들이 없으면 항목이 비고, Core 는 REST 만 서빙한다. -->
    <Content Update="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Mono.Protocol\Mono.Protocol.csproj" />
    <ProjectReference Include="..\Mono.Shared\Mono.Shared.csproj" />
  </ItemGroup>
  <!-- 파트너 키(릴리스 빌드 전용). 환경변수 MONO_BUILD_* 로만 들어오고, 소스에는 어떤 값도 없다.
       값이 없으면 빈 문자열이 들어가고 Core 는 키 없는 빌드처럼 돈다 — 로컬 빌드 · 포크 · 테스트가 이 경우다.
       런타임에 사용자가 주는 MONO_* 와 이름이 다르다: 개발자의 개인 키가 실수로 빌드에 구워지지 않게.
       생성 파일은 obj/ 에만 둔다(커밋할 수 없는 자리). 오류 메시지에 값을 싣지 않는다.
       설계: docs/09-스트리밍-키-설계.md -->
  <Target Name="GeneratePartnerKeys" BeforeTargets="BeforeCompile;CoreCompile">
    <PropertyGroup>
      <_PkTidalId>$(MONO_BUILD_TIDAL_CLIENT_ID)</_PkTidalId>
      <_PkQobuzId>$(MONO_BUILD_QOBUZ_APP_ID)</_PkQobuzId>
      <_PkQobuzSecret>$(MONO_BUILD_QOBUZ_APP_SECRET)</_PkQobuzSecret>
      <_PkValid>$([System.Text.RegularExpressions.Regex]::IsMatch('$(_PkTidalId)$(_PkQobuzId)$(_PkQobuzSecret)', '^[A-Za-z0-9_.~=+/-]*$'))</_PkValid>
      <_PkFile>$(IntermediateOutputPath)PartnerKeys.g.cs</_PkFile>
    </PropertyGroup>
    <Error Condition="'$(_PkValid)' != 'True'" Text="MONO_BUILD_* 값에 허용되지 않는 문자가 있습니다. 영문 · 숫자와 _ . ~ = + / - 만 쓸 수 있습니다." />
    <ItemGroup>
      <_PkLine Include="namespace Mono.Core%3B" />
      <_PkLine Include="internal static class BuildKeys" />
      <_PkLine Include="{" />
      <_PkLine Include="public const string TidalClientId = &quot;$(_PkTidalId)&quot;%3B" />
      <_PkLine Include="public const string QobuzAppId = &quot;$(_PkQobuzId)&quot;%3B" />
      <_PkLine Include="public const string QobuzAppSecret = &quot;$(_PkQobuzSecret)&quot;%3B" />
      <_PkLine Include="}" />
    </ItemGroup>
    <WriteLinesToFile File="$(_PkFile)" Lines="@(_PkLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(_PkFile)" />
      <FileWrites Include="$(_PkFile)" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <InternalsVisibleTo Include="Mono.Tests" />
    <Compile Include="..\Mono.Audio\PositionedMediaFoundationReader.cs" Link="Audio\PositionedMediaFoundationReader.cs" />
  </ItemGroup>
</Project>
