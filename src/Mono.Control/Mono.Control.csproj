<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Mono.Control</RootNamespace>
    <AssemblyName>Mono.Control</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>Assets\icons\app\mono-app.ico</ApplicationIcon>
    <!-- publish.ps1 이 -p:Version 으로 덮어쓴다. AssemblyVersion 을 따로 박으면
         그쪽이 이겨서 About 에 옛 버전이 찍힌다. -->
    <Version>0.1.5</Version>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**\*" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Svg" Version="11.2.0.2" />
    <PackageReference Include="Avalonia.Svg.Skia" Version="11.2.0.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Mono.Protocol\Mono.Protocol.csproj" />
    <ProjectReference Include="..\Mono.Shared\Mono.Shared.csproj" />
  </ItemGroup>
</Project>
