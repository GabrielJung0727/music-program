{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mono-core",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "src/Mono.Core",
        "-p:RollForward=Major"
      ],
      "port": 7702
    },
    {
      "name": "mono-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "src/Mono.Web"
      ],
      "port": 5273
    },
    {
      "name": "mono-mock-core",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "mock",
        "--prefix",
        "src/Mono.Web"
      ],
      "port": 7802
    },
    {
      "name": "mono-web-on-mock",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set CORE=http://127.0.0.1:7802&& npm run dev --prefix src/Mono.Web"
      ],
      "port": 5273
    }
  ]
}